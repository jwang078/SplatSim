# keep each top level section alphabetical
# keep each item within the sections alphabetical

# large files
*.png
*.gif

# mac
*.DS_Store

# misc
*logs*
*runs*
*tb_logs*
*wandb*
*wandb_logs*
outputs/*

# python
*__pycache__
**/__pycache__
*.egg-info
*.hypothesis
*.ipynb_checkpoints
*.mypy_cache
*.pyc

# vim
*.swp
MUJOCO_LOG.TXT

# build
**/build/*
# LeRobot fork cloned by install.sh (not a submodule: co-developed, no pin)
external/
data/datasets/*
output/*
scripts/recordings/

# generated at runtime / by helper scripts
# Scene assets (splats, SfM, segmentation builds) are downloaded, not
# committed — but each scene's scene.yaml IS tracked, so a fresh clone knows
# every scene's config and only the bytes are missing. See README, Data layout.
data/scenes/**
!data/scenes/**/
!data/scenes/**/scene.yaml
data/scenarios/
scripts/outputs/
