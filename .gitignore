# keep each top level section alphabetical
# keep each item within the sections alphabetical

# large files
*.png
*.gif

# mac
*.DS_Store

# misc
*logs*
*runs*
*tb_logs*
*wandb*
*wandb_logs*
outputs/*

# python
*__pycache__
**/__pycache__
*.egg-info
*.hypothesis
*.ipynb_checkpoints
*.mypy_cache
*.pyc

# vim
*.swp
MUJOCO_LOG.TXT

# build
**/build/*
# LeRobot fork cloned by install.sh (not a submodule: co-developed, no pin)
external/
data/datasets/*
output/*
scripts/recordings/

# generated at runtime / by helper scripts
# Stage data (splats, SfM, segmentation builds) is downloaded, not
# committed — but every stage.yaml / asset.yaml IS tracked, so a fresh clone
# knows each entry's config and only the bytes are missing. See README.
data/stages/**
!data/stages/**/
!data/stages/**/stage.yaml
!data/stages/**/splat_labels.npy
!data/stages/**/splat_labels.json
data/assets/**
!data/assets/**/
!data/assets/**/asset.yaml
# bodies that ship with the repo (URDF + meshes)
!data/assets/panda/**
!data/assets/ur5/**
!data/assets/ur5e/**
!data/assets/dual_panda/**
!data/assets/floating_gripper/**
!data/assets/planar_3joint/**
data/scenarios/
scripts/outputs/
