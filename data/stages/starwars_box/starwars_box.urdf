<?xml version="1.0" ?>
<robot name="starwars_box" xmlns:xacro="http://ros.org/wiki/xacro">

  <link name="base_link">
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <box size="0.508 0.1524 0.2921"/>
      </geometry>
      <material name="DarkGrey">
        <color rgba="0.3 0.3 0.3 1.0"/>
      </material>
    </visual>

    <collision>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <box size="0.508 0.1524 0.2921"/>
      </geometry>
    </collision>

    <inertial>
      <mass value="2.0"/>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <inertia 
        ixx="0.01809" ixy="0.0" ixz="0.0" 
        iyy="0.05724" iyz="0.0" 
        izz="0.04689"/>
    </inertial>
  </link>

  <link name="world"/>
  <joint name="world_joint" type="fixed">
    <parent link="world"/>
    <child link="base_link"/>
    <origin rpy="0 0 0" xyz="0 0 0.14605"/>
  </joint>

</robot>